+static size_t
+GetSionnaElementIndex(Ptr<const PhasedArrayModel> antenna, size_t index)
+{
+    auto upa = DynamicCast<const UniformPlanarArray>(antenna);
+    if (!upa)
+    {
+        return index; // modelled as a single element, see MakePlannarArray
+    }
+    const size_t rows = upa->GetNumRows();
+    const size_t cols = upa->GetNumColumns();
+    const size_t pol = index / (rows * cols);
+    const size_t row = (index % (rows * cols)) / cols;
+    const size_t col = index % cols;
+    return pol * rows * cols + col * rows + (rows - 1 - row);
+}
