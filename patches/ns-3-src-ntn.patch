+/**
+ * @ingroup mobility-test
+ * @ingroup leo
+ *
+ * @brief Test that the geographic position and the distance of a LEO satellite come from its
+ * orbit.
+ *
+ * The model keeps its state in orbital members and never sets the base class's lat/lon/alt, so
+ * both used to report a point on the equator at sea level. The altitude must be the orbit's,
+ * the geographic position must map back to the ECEF position, and the distance to a ground node
+ * must be the ECEF distance, whichever end it is asked from.
+ */
+class LeoGeographicPositionTestCase : public TestCase
+{
+  public:
+    LeoGeographicPositionTestCase();
+
+  private:
+    void DoRun() override;
+};
+
+LeoGeographicPositionTestCase::LeoGeographicPositionTestCase()
+    : TestCase("LEO geographic position and distance follow the orbit")
+{
+}
+
+void
+LeoGeographicPositionTestCase::DoRun()
+{
+    auto sat = CreateObject<LeoCircularOrbitMobilityModel>();
+    sat->SetAttribute("Altitude", DoubleValue(600.0));   // km
+    sat->SetAttribute("Inclination", DoubleValue(53.0)); // degrees
+    sat->SetAttribute("Resolution", TimeValue(Seconds(0)));
+    sat->SetPosition(Vector(20.0, 30.0, 0.0)); // longitude, orbital offset (degrees)
+
+    const Vector geo = sat->GetGeographicPosition();
+    NS_TEST_ASSERT_MSG_EQ_TOL(geo.z, 600e3, 1e-3, "Altitude is not the orbit's");
+    const Vector ecef = sat->GetGeocentricPosition();
+    const Vector back =
+        GeographicPositions::GeographicToCartesianCoordinates(geo.x,
+                                                              geo.y,
+                                                              geo.z,
+                                                              GeographicPositions::SPHERE);
+    NS_TEST_ASSERT_MSG_EQ_TOL((back - ecef).GetLength(),
+                              0,
+                              1e-3,
+                              "Geographic position does not map back to the ECEF position");
+
+    auto ground = CreateObject<GeocentricConstantPositionMobilityModel>();
+    ground->SetGeographicPosition(Vector(45.0, 20.0, 0.0));
+    const double expected = (ecef - ground->GetGeocentricPosition()).GetLength();
+    NS_TEST_ASSERT_MSG_EQ_TOL(sat->GetDistanceFrom(ground),
+                              expected,
+                              1e-3,
+                              "Distance asked from the satellite is not the ECEF distance");
+    NS_TEST_ASSERT_MSG_EQ_TOL(ground->GetDistanceFrom(sat),
+                              expected,
+                              1e-3,
+                              "Distance asked from the ground is not the ECEF distance");
+
+    Simulator::Destroy();
+}
