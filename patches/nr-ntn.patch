+/**
+ * @brief Checks Rel-17 downlinkHARQ-FeedbackDisabled
+ *
+ * With feedback disabled the DL HARQ process must be released in the slot it is transmitted,
+ * rather than held until an ACK or NACK returns. Holding it is what limits the pipeline to one
+ * transport block per process per loop round trip.
+ */
+class NrTestMacSchedulerDlHarqFeedbackDisabled : public TestCase
+{
+  public:
+    /**
+     * @brief Constructor
+     * @param feedbackDisabled value of the DlHarqFeedbackDisabled attribute
+     * @param expectedProcesses HARQ processes still held after one DL slot
+     * @param name test case name
+     */
+    NrTestMacSchedulerDlHarqFeedbackDisabled(bool feedbackDisabled,
+                                             uint32_t expectedProcesses,
+                                             const std::string& name)
+        : TestCase(name),
+          m_feedbackDisabled(feedbackDisabled),
+          m_expectedProcesses(expectedProcesses)
+    {
+    }
+
+  private:
+    void DoRun() override;
+
+    bool m_feedbackDisabled;      //!< value of the DlHarqFeedbackDisabled attribute
+    uint32_t m_expectedProcesses; //!< HARQ processes still held after one DL slot
+};
+
+void
+NrTestMacSchedulerDlHarqFeedbackDisabled::DoRun()
+{
+    const uint16_t rnti = 1;
+
+    auto* schedSapUser = new TestSchedSapUserHarq();
+    auto* cschedSapUser = new TestCschedSapUserHarq();
+
+    Ptr<NrMacSchedulerNs3> sched = CreateObject<NrMacSchedulerTdmaRR>();
+    sched->SetAttribute("DlHarqFeedbackDisabled", BooleanValue(m_feedbackDisabled));
+    sched->InstallDlAmc(CreateObject<NrAmc>());
+    sched->InstallUlAmc(CreateObject<NrAmc>());
+    sched->SetMacSchedSapUser(schedSapUser);
+    sched->SetMacCschedSapUser(cschedSapUser);
+
+    auto cellConfig = NrMacCschedSapProvider::CschedCellConfigReqParameters();
+    cellConfig.m_dlBandwidth = 10;
+    cellConfig.m_ulBandwidth = 10;
+    sched->DoCschedCellConfigReq(cellConfig);
+
+    NrMacCschedSapProvider::CschedUeConfigReqParameters ueConf{};
+    ueConf.m_rnti = rnti;
+    ueConf.m_transmissionMode = 0;
+    ueConf.m_beamId = BeamId(0, 0);
+    sched->DoCschedUeConfigReq(ueConf);
+
+    NrMacCschedSapProvider::CschedLcConfigReqParameters lcConf;
+    lcConf.m_rnti = rnti;
+    lcConf.m_reconfigureFlag = false;
+    nr::LogicalChannelConfigListElement_s lc;
+    lc.m_direction = nr::LogicalChannelConfigListElement_s::Direction_e::DIR_BOTH;
+    lc.m_qosBearerType = nr::LogicalChannelConfigListElement_s::QosBearerType_e::QBT_NON_GBR;
+    lc.m_fiveQi = 9;
+    lc.m_logicalChannelGroup = 3;
+    lc.m_logicalChannelIdentity = 3;
+    lcConf.m_logicalChannelConfigList.emplace_back(lc);
+    sched->DoCschedLcConfigReq(lcConf);
+
+    NrMacSchedSapProvider::SchedDlRlcBufferReqParameters bufferReq{};
+    bufferReq.m_rnti = rnti;
+    bufferReq.m_logicalChannelIdentity = 3;
+    bufferReq.m_rlcRetransmissionQueueSize = 0;
+    bufferReq.m_rlcTransmissionQueueSize = 10000;
+    sched->DoSchedDlRlcBufferReq(bufferReq);
+
+    NrMacSchedSapProvider::SchedDlTriggerReqParameters trigger;
+    trigger.m_snfSf = SfnSf(0, 0, 0, 0);
+    trigger.m_slotType = LteNrTddSlotType::DL;
+    sched->DoSchedDlTriggerReq(trigger);
+
+    const auto& ueInfo = sched->m_ueMap.find(rnti)->second;
+    NS_TEST_ASSERT_MSG_EQ(ueInfo->m_dlHarq.Size(),
+                          m_expectedProcesses,
+                          "Unexpected number of DL HARQ processes held after the slot");
+
+    delete schedSapUser;
+    delete cschedSapUser;
+    Simulator::Destroy();
+}
