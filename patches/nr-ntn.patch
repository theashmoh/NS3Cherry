+/**
+ * @ingroup tests
+ *
+ * @brief Regression test for the buffer status report after a NACK.
+ *
+ * The buffer status report counts PDUs pending retransmission but not those merely awaiting
+ * acknowledgement, so a STATUS PDU that NACKs an SN creates data volume the MAC has not heard
+ * of. The entity must report it at once instead of waiting for the next SDU, poll or
+ * BufferStatusReportTimer tick, which added up to 20 ms to every ARQ recovery.
+ */
+class NrRlcAmNackReportTestCase : public NrRlcTestCaseBase
+{
+  public:
+    NrRlcAmNackReportTestCase()
+        : NrRlcTestCaseBase("Test RLC AM TX: a NACK is reported to the MAC at once")
+    {
+    }
+
+  private:
+    void DoRun() override;
+};
+
+void
+NrRlcAmNackReportTestCase::DoRun()
+{
+    Ptr<NrRlcAm> rlc = CreateObject<NrRlcAm>();
+
+    Ptr<NrTestMac> mac = CreateObject<NrTestMac>();
+    mac->SetRlcHeaderType(NrTestMac::AM_RLC_HEADER);
+    rlc->SetNrMacSapProvider(mac->GetNrMacSapProvider());
+    mac->SetNrMacSapUser(rlc->GetNrMacSapUser());
+
+    // Emit SN=0 and SN=1; both then wait in the txed buffer for acknowledgement.
+    TransmitSdusAligned(rlc, {{'A', 20}, {'B', 20}}, 100);
+    const uint32_t reportsBeforeNack = mac->GetBufferStatusReportCount();
+
+    DeliverStatusPdu(rlc, 2, {0});
+    NS_TEST_ASSERT_MSG_EQ((rlc->m_retxBuffer.at(0).m_pdu != nullptr),
+                          true,
+                          "precondition: the NACKed SN=0 must move to the retx buffer");
+    NS_TEST_ASSERT_MSG_EQ(mac->GetBufferStatusReportCount(),
+                          reportsBeforeNack + 1,
+                          "a NACK must trigger a buffer status report");
+    NS_TEST_ASSERT_MSG_EQ(mac->GetLastBufferStatusReport().retxQueueSize,
+                          rlc->m_retxBufferSize,
+                          "the report must carry the NACKed PDU as retransmission volume");
+
+    // A STATUS PDU that only acknowledges moves nothing into the retx buffer: no report.
+    const uint32_t reportsBeforeAck = mac->GetBufferStatusReportCount();
+    DeliverStatusPdu(rlc, 2, {});
+    NS_TEST_ASSERT_MSG_EQ(mac->GetBufferStatusReportCount(),
+                          reportsBeforeAck,
+                          "an ACK-only STATUS PDU must not trigger a buffer status report");
+
+    Simulator::Destroy();
+}
