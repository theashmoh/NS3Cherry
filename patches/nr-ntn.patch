+}
+
+double
+AmplifyForwardEndToEndSnrDb(double gamma1Db, double gamma2Db)
+{
+    const double gamma1 = DbToLinear(gamma1Db);
+    const double gamma2 = DbToLinear(gamma2Db);
+    return LinearToDb((gamma1 * gamma2) / (gamma1 + gamma2 + 1.0));
+}
