+/**
+ * @brief Checks that a HARQ process is reclaimed on the configured schedule
+ *
+ * NrMacSchedulerNs3::ResetExpiredHARQ reclaims a process whose feedback never came back.
+ * Upstream ties that wait to NumHarqProcess, so the pipeline depth also decides how long the
+ * scheduler waits for a report; HarqProcessTimeout separates the two. The test also covers the
+ * process that has already been NACKed, which must survive until its retransmission is sent.
+ */
+class NrTestMacSchedulerHarqProcessTimeout : public TestCase
+{
+  public:
+    NrTestMacSchedulerHarqProcessTimeout()
+        : TestCase("Reclaim a HARQ process on the configured timeout, not on NumHarqProcess")
+    {
+    }
+
+  private:
+    void DoRun() override;
+
+    /**
+     * @brief Age one process until it is reclaimed
+     * @param timeout value of the HarqProcessTimeout attribute
+     * @param status status the process is left in
+     * @param maxSlots give up after this many calls
+     * @return calls to ResetExpiredHARQ needed to reclaim it, or maxSlots if it survived
+     */
+    uint32_t SlotsUntilReclaimed(uint32_t timeout, HarqProcess::Status status, uint32_t maxSlots);
+};
+
+uint32_t
+NrTestMacSchedulerHarqProcessTimeout::SlotsUntilReclaimed(uint32_t timeout,
+                                                          HarqProcess::Status status,
+                                                          uint32_t maxSlots)
+{
+    const uint16_t rnti = 0;
+
+    auto* schedSapUser = new TestSchedSapUserHarq();
+    auto* cschedSapUser = new TestCschedSapUserHarq();
+
+    Ptr<NrMacSchedulerNs3> sched = CreateObject<NrMacSchedulerTdmaRR>();
+    sched->SetAttribute("HarqProcessTimeout", UintegerValue(timeout));
+    sched->InstallDlAmc(CreateObject<NrAmc>());
+    sched->InstallUlAmc(CreateObject<NrAmc>());
+    sched->SetMacSchedSapUser(schedSapUser);
+    sched->SetMacCschedSapUser(cschedSapUser);
+
+    auto cellConfig = NrMacCschedSapProvider::CschedCellConfigReqParameters();
+    cellConfig.m_dlBandwidth = 10;
+    cellConfig.m_ulBandwidth = 10;
+    sched->DoCschedCellConfigReq(cellConfig);
+
+    NrMacCschedSapProvider::CschedUeConfigReqParameters ueConf{};
+    ueConf.m_rnti = rnti;
+    ueConf.m_transmissionMode = 0;
+    ueConf.m_beamId = BeamId(0, 0);
+    sched->DoCschedUeConfigReq(ueConf);
+
+    auto& ueInfo = sched->m_ueMap.find(rnti)->second;
+    // ResetExpiredHARQ only reads the status and the timer, so the DCI can stay empty.
+    // Insert() rather than writing the process in place, so the vector's used size stays right.
+    uint8_t harqId = 0;
+    ueInfo->m_dlHarq.Insert(&harqId, HarqProcess(true, status, 0, nullptr));
+
+    uint32_t slots = 0;
+    while (slots < maxSlots && ueInfo->m_dlHarq.Find(harqId)->second.m_active)
+    {
+        sched->ResetExpiredHARQ(rnti, &ueInfo->m_dlHarq);
+        ++slots;
+    }
+
+    delete schedSapUser;
+    delete cschedSapUser;
+    Simulator::Destroy();
+    return slots;
+}
+
+void
+NrTestMacSchedulerHarqProcessTimeout::DoRun()
+{
+    // TestSchedSapUserHarq reports 20 HARQ processes, which is the legacy lifetime
+    NS_TEST_ASSERT_MSG_EQ(SlotsUntilReclaimed(0, HarqProcess::WAITING_FEEDBACK, 200),
+                          21,
+                          "With the timeout disabled a process must still be reclaimed after "
+                          "NumHarqProcess slots, as before");
+
+    NS_TEST_ASSERT_MSG_EQ(SlotsUntilReclaimed(40, HarqProcess::WAITING_FEEDBACK, 200),
+                          41,
+                          "A configured timeout must decide the lifetime, independently of the "
+                          "number of HARQ processes");
+
+    NS_TEST_ASSERT_MSG_EQ(SlotsUntilReclaimed(5, HarqProcess::WAITING_FEEDBACK, 200),
+                          6,
+                          "A timeout shorter than the process count must also be honoured");
+
+    // A NACKed process is waiting to be retransmitted, not waiting for feedback
+    NS_TEST_ASSERT_MSG_EQ(SlotsUntilReclaimed(5, HarqProcess::RECEIVED_FEEDBACK, 200),
+                          200,
+                          "A process that has already received feedback must not be reclaimed "
+                          "out from under the retransmission");
+}
