index e07a82f5..2396aa0f 100644
--- a/model/nr-phy-sap.h
+++ b/model/nr-phy-sap.h
@@ -131,6 +131,37 @@ class NR_EXPORT NrPhySapProvider
      */
     virtual Time GetSlotPeriod() const = 0;
 
+    /**
+     * @brief Get the additional NTN scheduling delay in active slots.
+     * @return Cell-specific K_offset scaled to this BWP, or 0 for terrestrial PHYs.
+     */
+    virtual uint32_t GetCellSpecificKoffsetSlots() const
+    {
+        return 0;
+    }
+
+    /**
+     * @brief Get the timing advance the PHY applies to its uplink transmissions.
+     * @return NrUePhy::TimingAdvance, the estimated one-way propagation delay to the serving
+     * gNB, or zero for PHYs without a timing advance (gNB PHYs, terrestrial UEs).
+     */
