+
+#include "ns3/constant-position-mobility-model.h"
+#include "ns3/constant-velocity-mobility-model.h"
+#include "ns3/double.h"
+#include "ns3/nr-ntn-link-models.h"
+#include "ns3/nstime.h"
+#include "ns3/propagation-loss-model.h"
+#include "ns3/simulator.h"
+#include "ns3/test.h"
+#include "ns3/vector.h"
+
+#include <cmath>
+
+/**
+ * @file nr-test-ntn-link-models.cc
+ * @ingroup test
+ *
+ * @brief Validation of the NTN link budget and loop delay of NrNtnFeederNoiseLossModel and
+ * NrNtnPropagationDelayModel.
+ *
+ * The gNB sits on the serving satellite. A transparent payload adds the feeder link, gateway ->
+ * satellite, to the delay and charges the noise the relay forwards to the downlink budget; a
+ * regenerative one is the satellite <-> UE hop alone. These cases check the
+ * closed-form results against hand-computed geometry, so a regression in the cascade, in the
+ * amplify-and-forward noise accounting or in the regenerative delay fails here instead of
+ * silently shifting every NTN throughput number.
+ */
+
+namespace ns3
+{
+
+namespace
+{
+
+constexpr double SpeedOfLightMps = 299792458.0;
+constexpr double FrequencyHz = 3.5e9;
+
+/// Free-space path loss in dB, what FriisPropagationLossModel gives at FrequencyHz
+double
+Fspl(double distanceM)
+{
+    return 20.0 * std::log10((4.0 * M_PI * distanceM * FrequencyHz) / SpeedOfLightMps);
+}
+
+Ptr<ConstantPositionMobilityModel>
+At(double x, double y, double z)
+{
+    Ptr<ConstantPositionMobilityModel> m = CreateObject<ConstantPositionMobilityModel>();
+    m->SetPosition(Vector(x, y, z));
+    return m;
+}
+
+/// Geometry shared by the cases: gateway and UE on different sides of the satellite, so a
+/// swapped hop shows up. The gNB is on the satellite.
+struct Chain
+{
+    Chain()
+        : gt(At(0, 0, 0)),
+          sat(At(0, 0, 600e3)),
+          ue(At(0, 300e3, 0))
+    {
+    }
+
+    double FeederM() const
+    {
+        return 600e3;
+    }
+
+    double ServiceM() const
+    {
+        return std::sqrt(300e3 * 300e3 + 600e3 * 600e3);
+    }
+
+    Ptr<ConstantPositionMobilityModel> gt;
+    Ptr<ConstantPositionMobilityModel> sat;
+    Ptr<ConstantPositionMobilityModel> ue;
+};
+
+Ptr<PropagationLossModel>
+Friis()
+{
+    Ptr<FriisPropagationLossModel> friis = CreateObject<FriisPropagationLossModel>();
+    friis->SetFrequency(FrequencyHz);
+    return friis;
+}
+
+} // namespace
+
+/**
+ * @brief Transparent: the one-way delay crosses the feeder and the service link and the relay;
+ * regenerative: the service link alone.
+ */
+class NrNtnLoopDelayTestCase : public TestCase
+{
+  public:
+    NrNtnLoopDelayTestCase()
+        : TestCase("NTN one-way delay follows the transparent chain or the regenerative hop")
+    {
+    }
+
+  private:
+    void DoRun() override
+    {
+        Chain chain;
+        Ptr<NrNtnPropagationDelayModel> delay = CreateObject<NrNtnPropagationDelayModel>();
+
+        // Regenerative: the service hop, and the feeder geometry is irrelevant
+        const double serviceS = chain.ServiceM() / SpeedOfLightMps;
+        NS_TEST_ASSERT_MSG_EQ_TOL(delay->GetOneWayDelay(chain.sat, chain.ue).GetSeconds(),
+                                  serviceS,
+                                  1e-9,
+                                  "Regenerative delay must be satellite <-> UE / c");
+        delay->SetAttribute("RelayProcessingDelay", TimeValue(MicroSeconds(250)));
+        NS_TEST_ASSERT_MSG_EQ_TOL(delay->GetOneWayDelay(chain.sat, chain.ue).GetSeconds(),
+                                  serviceS,
+                                  1e-9,
+                                  "No relay is crossed, so its processing must not count");
+
+        // Transparent: feeder + service, and one relay traversal per direction
+        delay->SetFeeder(chain.gt);
+        const double oneWayS = (chain.FeederM() + chain.ServiceM()) / SpeedOfLightMps;
+        NS_TEST_ASSERT_MSG_EQ_TOL(
+            delay->GetOneWayDelay(chain.sat, chain.ue).GetSeconds(),
+            oneWayS + 250e-6,
+            1e-9,
+            "Transparent delay must be (feeder + service) / c plus the relay");
+        chain.gt->SetPosition(Vector(0, 0, -300e3));
+        NS_TEST_ASSERT_MSG_EQ_TOL(delay->GetOneWayDelay(chain.sat, chain.ue).GetSeconds(),
+                                  oneWayS + 300e3 / SpeedOfLightMps + 250e-6,
+                                  1e-9,
+                                  "Transparent delay must follow the live feeder geometry");
+    }
+};
+
+/**
+ * @brief Amplify-and-forward pays for the noise the relay forwards; the uplink pays the feeder
+ * loss minus the relay gain.
+ */
+class NrNtnFeederNoiseTestCase : public TestCase
+{
+  public:
+    NrNtnFeederNoiseTestCase()
+        : TestCase("Transparent feeder link: forwarded relay noise and uplink feeder loss")
+    {
+    }
+
+  private:
+    void DoRun() override
+    {
+        Chain chain;
+        Ptr<NrNtnFeederNoiseLossModel> feeder = CreateObject<NrNtnFeederNoiseLossModel>();
+        feeder->SetFeeder(chain.gt, Friis());
+        feeder->SetAttribute("GatewayTxPowerDbm", DoubleValue(60.0));
+        feeder->SetAttribute("SatRxAntennaGainDb", DoubleValue(30.0));
+        feeder->SetAttribute("RelayLossDb", DoubleValue(3.0));
+        feeder->SetAttribute("RelayInputNoisePowerDbm", DoubleValue(-100.0));
+        feeder->SetAttribute("ReceiverNoisePowerDbm", DoubleValue(-100.0));
+
+        NS_TEST_ASSERT_MSG_EQ_TOL(feeder->GetFeederLossDb(chain.sat),
+                                  Fspl(chain.FeederM()),
+                                  1e-6,
+                                  "The feeder loss is the gateway -> satellite link");
+
+        // Closed form of the cascade: 1/SNR = 1/SNR_feeder + 1/SNR_service, the relay adding
+        // one unit of its own noise on top of each (the "+1" of an automatic gain control)
+        const double eirpDbm = 78.0;
+        const double serviceDb = Fspl(chain.ServiceM());
+        const double feederSnr =
+            std::pow(10.0, (60.0 + 30.0 - Fspl(chain.FeederM()) - 3.0 + 100.0) / 10.0);
+        const double serviceSnr = std::pow(10.0, (eirpDbm - serviceDb + 100.0) / 10.0);
+        const double cascadeDb =
+            10.0 * std::log10(feederSnr * serviceSnr / (feederSnr + serviceSnr + 1.0));
+        const double snrDb = feeder->GetDownlinkSnrDb(eirpDbm, Fspl(chain.FeederM()), serviceDb);
+        NS_TEST_ASSERT_MSG_EQ_TOL(snrDb, cascadeDb, 1e-6, "Amplify-and-forward cascade SNR");
+
+        // A quiet relay front end is the ideal case: the service hop at the relay EIRP
+        feeder->SetAttribute("RelayInputNoisePowerDbm", DoubleValue(-130.0));
+        NS_TEST_ASSERT_MSG_GT(feeder->GetDownlinkSnrDb(eirpDbm, Fspl(chain.FeederM()), serviceDb),
+                              snrDb,
+                              "A noisier relay front end must lower the downlink SNR");
+        NS_TEST_ASSERT_MSG_EQ_TOL(
+            feeder->GetDownlinkSnrDb(eirpDbm, Fspl(chain.FeederM()), serviceDb),
+            eirpDbm - serviceDb + 100.0,
+            0.05,
+            "A noiseless relay must reduce to the service hop at the relay "
+            "EIRP");
+
+        // Links that are not gNB <-> UE, here two bare mobility models, keep the service loss
+        Ptr<PropagationLossModel> service = Friis();
+        feeder->SetServiceLoss(service);
+        NS_TEST_ASSERT_MSG_EQ_TOL(feeder->CalcRxPower(0.0, chain.sat, chain.ue),
+                                  -serviceDb,
+                                  1e-6,
+                                  "Without a gNB at either end only the service loss applies");
+    }
+};
+
+/**
+ * @brief The delay rate is the derivative of the one-way delay, feeder included, and a signal
+ * is compressed by it rounded toward shorter.
+ */
+class NrNtnDelayRateTestCase : public TestCase
+{
+  public:
+    NrNtnDelayRateTestCase()
+        : TestCase("NTN delay rate follows the one-way delay; the squeeze rounds toward shorter")
+    {
+    }
+
+  private:
+    void DoRun() override
+    {
+        // The satellite descends and drifts sideways over a static gateway and UE
+        Chain chain;
+        for (bool transparent : {false, true})
+        {
+            Ptr<ConstantVelocityMobilityModel> sat = CreateObject<ConstantVelocityMobilityModel>();
+            sat->SetPosition(chain.sat->GetPosition());
+            sat->SetVelocity(Vector(7000.0, 0.0, -1000.0));
+            Ptr<NrNtnPropagationDelayModel> delay = CreateObject<NrNtnPropagationDelayModel>();
+            if (transparent)
+            {
+                delay->SetFeeder(chain.gt);
+            }
+            const Time d0 = delay->GetOneWayDelay(sat, chain.ue);
+            const double rate = delay->GetOneWayDelayRate(sat, chain.ue);
+            const Time step = MilliSeconds(100);
+            Time d1;
+            Simulator::Schedule(step, [&]() { d1 = delay->GetOneWayDelay(sat, chain.ue); });
+            Simulator::Run();
+            Simulator::Destroy();
+            // Tolerance: the delays are whole ns (1 ns over the step) and the path curves, so the
+            // rate drifts by ~1e-8 over 100 ms here
+            const double finiteDiff = (d1 - d0).GetSeconds() / step.GetSeconds();
+            NS_TEST_ASSERT_MSG_LT(rate, 0.0, "An approaching satellite must shorten the delay");
+            NS_TEST_ASSERT_MSG_EQ_TOL(rate,
+                                      finiteDiff,
+                                      3e-8,
+                                      "Delay rate is not the derivative of the one-way delay"
+                                          << (transparent ? " with the feeder" : ""));
+        }
+
+        // 71428 ns sent while the delay shrinks by 1.79 ns: floor(-1.79) - 1 = -3 ns, so the
+        // arrival ends no later than it physically does and rounding cannot close the PHY's gap
+        const Time symbol = NanoSeconds(71428);
+        NS_TEST_ASSERT_MSG_EQ(NrNtnPropagationDelayModel::SqueezeDuration(symbol, -2.5e-5),
+                              NanoSeconds(71425),
+                              "Closing path: rounded toward shorter, one ns more");
+        NS_TEST_ASSERT_MSG_EQ(NrNtnPropagationDelayModel::SqueezeDuration(symbol, 2.5e-5),
+                              NanoSeconds(71429),
+                              "Opening path: stretched, rounded toward shorter");
+        NS_TEST_ASSERT_MSG_EQ(NrNtnPropagationDelayModel::SqueezeDuration(symbol, 0.0),
+                              symbol,
+                              "A static path must not change the duration");
+    }
+};
+
+/**
+ * @brief NTN link model validation suite.
+ */
+class NrNtnLinkModelsTestSuite : public TestSuite
+{
+  public:
+    NrNtnLinkModelsTestSuite()
+        : TestSuite("nr-ntn-link-models", Type::UNIT)
+    {
+        AddTestCase(new NrNtnLoopDelayTestCase, Duration::QUICK);
+        AddTestCase(new NrNtnFeederNoiseTestCase, Duration::QUICK);
+        AddTestCase(new NrNtnDelayRateTestCase, Duration::QUICK);
+    }
+};
+
+/// Static variable for test initialization
+static NrNtnLinkModelsTestSuite g_nrNtnLinkModelsTestSuite;
+
+} // namespace ns3
diff --git a/test/nr-test-ntn-propagation-timing.cc b/test/nr-test-ntn-propagation-timing.cc
new file mode 100644
index 00000000..0a9f173c
--- /dev/null
+++ b/test/nr-test-ntn-propagation-timing.cc
@@ -0,0 +1,375 @@
+// Copyright (c) 2026 Jesse Chiu (Kuan-Po), University of Washington
+//
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include "ns3/constant-position-mobility-model.h"
+#include "ns3/multi-model-spectrum-channel.h"
+#include "ns3/node.h"
+#include "ns3/nr-gnb-net-device.h"
+#include "ns3/nr-ntn-link-models.h"
+#include "ns3/nr-spectrum-signal-parameters.h"
+#include "ns3/nstime.h"
+#include "ns3/simple-net-device.h"
+#include "ns3/simulator.h"
+#include "ns3/spectrum-phy.h"
+#include "ns3/spectrum-value.h"
+#include "ns3/test.h"
+#include "ns3/vector.h"
+
+#include <cmath>
+#include <string>
+#include <utility>
+#include <vector>
+
+/**
+ * @file nr-test-ntn-propagation-timing.cc
+ * @ingroup test
+ *
+ * @brief The standard channel with NrNtnPropagationDelayModel delivers every signal after its
+ * physical delay.
+ *
+ * The gNB is on the satellite. Transparent payload: the signal also crosses the feeder link,
+ * GT -> satellite (reversed on the uplink), and pays the relay processing delay. Regenerative
+ * payload: the waveform exists only on the satellite<->UE hop and the feeder link and the relay
+ * processing no longer enter the radio delay. Both are checked against an independent geometric
+ * expectation, never against GetOneWayDelay(), and against a moved endpoint, so a cached delay
+ * would fail here.
+ */
+
+namespace ns3
+{
+namespace
+{
+
+constexpr double SpeedOfLightMps = 299792458.0;
+
+// Identify the gNB side without constructing an unrelated RRC/MAC stack.
+class TimingGnbDevice : public NrGnbNetDevice
+{
+  private:
+    void DoInitialize() override
+    {
+    }
+
+    void DoDispose() override
+    {
+        NrNetDevice::DoDispose();
+    }
+};
+
+// Observe real StartRx events without hiding channel timing behind NR slot scheduling.
+class ArrivalPhy : public SpectrumPhy
+{
+  public:
+    void SetDevice(Ptr<NetDevice> device) override
+    {
+        m_device = device;
+    }
+
+    Ptr<NetDevice> GetDevice() const override
+    {
+        return m_device;
+    }
+
+    void SetMobility(Ptr<MobilityModel> mobility) override
+    {
+        m_mobility = mobility;
+    }
+
+    Ptr<MobilityModel> GetMobility() const override
+    {
+        return m_mobility;
+    }
+
+    void SetChannel(Ptr<SpectrumChannel>) override
+    {
+    }
+
+    Ptr<const SpectrumModel> GetRxSpectrumModel() const override
+    {
+        return spectrum;
+    }
+
+    Ptr<Object> GetAntenna() const override
+    {
+        return nullptr;
+    }
+
+    void StartRx(Ptr<SpectrumSignalParameters> params) override
+    {
+        arrivals.push_back(Simulator::Now());
+        signals.push_back(params);
+    }
+
+    Ptr<const SpectrumModel> spectrum;
+    std::vector<Time> arrivals;
+    std::vector<Ptr<SpectrumSignalParameters>> signals;
+
+  private:
+    Ptr<NetDevice> m_device;
+    Ptr<MobilityModel> m_mobility;
+};
+
+/// The endpoints every case starts from: GT at the origin, the satellite (with the gNB) 1000 km
+/// along x at 600 km altitude, UE 300 km off the satellite's nadir. Both devices sit on nodes
+/// carrying their mobility, which is how the delay model tells the gNB end from the UE end.
+struct Bench
+{
+    Ptr<ConstantPositionMobilityModel> gt;
+    Ptr<ConstantPositionMobilityModel> sat;
+    Ptr<ConstantPositionMobilityModel> ue;
+    Ptr<MultiModelSpectrumChannel> channel;
+    Ptr<NrNtnPropagationDelayModel> delay;
+    Ptr<SpectrumModel> model;
+    Ptr<ArrivalPhy> gnbPhy;
+    Ptr<ArrivalPhy> uePhy;
+};
+
+Bench
+MakeBench()
+{
+    auto at = [](Vector position) {
+        auto mobility = CreateObject<ConstantPositionMobilityModel>();
+        mobility->SetPosition(position);
+        return mobility;
+    };
+    Bench b;
+    b.gt = at(Vector(0, 0, 0));
+    b.sat = at(Vector(1000000, 0, 600000));
+    b.ue = at(Vector(1000000, 300000, 0));
+    b.channel = CreateObject<MultiModelSpectrumChannel>();
+    b.delay = CreateObject<NrNtnPropagationDelayModel>();
+    b.delay->SetAttribute("RelayProcessingDelay", TimeValue(MicroSeconds(250)));
+    b.channel->SetPropagationDelayModel(b.delay);
+
+    // ns-3.48 SpectrumModel derives each band edge from its neighbour, so it needs at least two
+    // center frequencies (spectrum-model.cc:35); the timing assertions do not depend on the PSD.
+    b.model = Create<SpectrumModel>(std::vector<double>{3.5e9, 3.5e9 + 180e3});
+    b.gnbPhy = CreateObject<ArrivalPhy>();
+    b.uePhy = CreateObject<ArrivalPhy>();
+    b.gnbPhy->spectrum = b.model;
+    b.uePhy->spectrum = b.model;
+    b.gnbPhy->SetMobility(b.sat);
+    b.uePhy->SetMobility(b.ue);
+    b.gnbPhy->SetDevice(CreateObject<TimingGnbDevice>());
+    b.uePhy->SetDevice(CreateObject<SimpleNetDevice>());
+    for (auto [phy, mobility] :
+         {std::pair<Ptr<ArrivalPhy>, Ptr<MobilityModel>>{b.gnbPhy, b.sat}, {b.uePhy, b.ue}})
+    {
+        auto node = CreateObject<Node>();
+        node->AggregateObject(mobility);
+        node->AddDevice(phy->GetDevice());
+    }
+    return b;
+}
+
+/// One NR frame of the requested kind, 10 us long, flat unit PSD.
+Ptr<SpectrumSignalParameters>
+MakeSignal(bool uplink, bool control, Ptr<SpectrumPhy> tx, Ptr<const SpectrumModel> model)
+{
+    Ptr<SpectrumSignalParameters> signal;
+    if (!control)
+    {
+        auto data = Create<NrSpectrumSignalParametersDataFrame>();
+        data->cellId = 1;
+        signal = data;
+    }
+    else if (uplink)
+    {
+        auto ctrl = Create<NrSpectrumSignalParametersUlCtrlFrame>();
+        ctrl->cellId = 1;
+        signal = ctrl;
+    }
+    else
+    {
+        auto ctrl = Create<NrSpectrumSignalParametersDlCtrlFrame>();
+        ctrl->cellId = 1;
+        ctrl->pss = false;
+        signal = ctrl;
+    }
+    signal->txPhy = tx;
+    signal->duration = MicroSeconds(10);
+    signal->psd = Create<SpectrumValue>(model);
+    *signal->psd = 1.0;
+    return signal;
+}
+
+/// Satellite (1000, 0, 600) km to the UE (1000, 300, 0) km: the service hop of the bench.
+const Time g_serviceDelay = Seconds(std::sqrt(450000000000.0) / SpeedOfLightMps);
+
+class NtnPropagationTimingCase : public TestCase
+{
+  public:
+    NtnPropagationTimingCase(bool uplink, bool control)
+        : TestCase(std::string("Transparent ") + (uplink ? "UL " : "DL ") +
+                   (control ? "control" : "data") + " crosses the feeder link and both relays"),
+          m_uplink(uplink),
+          m_control(control)
+    {
+    }
+
+  private:
+    void DoRun() override
+    {
+        Bench b = MakeBench();
+        b.delay->SetFeeder(b.gt);
+        Ptr<ArrivalPhy> tx = m_uplink ? b.uePhy : b.gnbPhy;
+        Ptr<ArrivalPhy> rx = m_uplink ? b.gnbPhy : b.uePhy;
+        b.channel->AddRx(rx);
+        Ptr<SpectrumSignalParameters> signal = MakeSignal(m_uplink, m_control, tx, b.model);
+
+        // Independent geometric expectation, deliberately not GetOneWayDelay().
+        const double feederDistance = std::sqrt(1360000000000.0);
+        const double firstDistance = feederDistance + std::sqrt(450000000000.0);
+        const Time firstDelay = Seconds(firstDistance / SpeedOfLightMps) + MicroSeconds(250);
+        const Time firstTx = MilliSeconds(1);
+        Simulator::Schedule(firstTx, &MultiModelSpectrumChannel::StartTx, b.channel, signal);
+        Simulator::Schedule(firstTx + firstDelay - NanoSeconds(1), [this, rx]() {
+            NS_TEST_ASSERT_MSG_EQ(rx->arrivals.size(),
+                                  0,
+                                  "Signal arrived before its physical delay");
+        });
+
+        // A later transmission must use the new geometry, not a cached initial RTT.
+        const Time secondTx = MilliSeconds(100);
+        Simulator::Schedule(secondTx, [b, signal]() {
+            b.ue->SetPosition(Vector(1000000, 800000, 0));
+            b.channel->StartTx(signal);
+        });
+        const Time secondDelay =
+            Seconds((feederDistance + 1000000.0) / SpeedOfLightMps) + MicroSeconds(250);
+        Simulator::Run();
+
+        NS_TEST_ASSERT_MSG_EQ(rx->arrivals.size(),
+                              2,
+                              "Both transmissions must arrive exactly once");
+        if (rx->arrivals.size() == 2)
+        {
+            NS_TEST_ASSERT_MSG_EQ(rx->arrivals[0],
+                                  firstTx + firstDelay,
+                                  "Initial arrival must include all three hops and two relays");
+            NS_TEST_ASSERT_MSG_EQ(rx->arrivals[1],
+                                  secondTx + secondDelay,
+                                  "Arrival must follow the updated geometry");
+            NS_TEST_ASSERT_MSG_EQ(rx->signals[0]->duration,
+                                  signal->duration,
+                                  "Propagation must preserve signal duration");
+        }
+        Simulator::Destroy();
+    }
+
+    bool m_uplink;
+    bool m_control;
+};
+
+/**
+ * @brief Regenerative: the radio delay is the satellite<->UE hop, in both directions.
+ *
+ * The feeder link and the relay processing are backhaul, not radio: moving the gateway must
+ * leave the arrival time alone, while moving the UE must still move it. The GetOneWayDelay() the
+ * examples size K_offset and the timing advance from has to agree with what actually arrived.
+ */
+class NtnRegenerativeTimingCase : public TestCase
+{
+  public:
+    NtnRegenerativeTimingCase(bool uplink, bool control)
+        : TestCase(std::string("Regenerative ") + (uplink ? "UL " : "DL ") +
+                   (control ? "control" : "data") + " is delayed by the service hop only"),
+          m_uplink(uplink),
+          m_control(control)
+    {
+    }
+
+  private:
+    void DoRun() override
+    {
+        Bench b = MakeBench(); // no feeder link: regenerative
+        Ptr<ArrivalPhy> tx = m_uplink ? b.uePhy : b.gnbPhy;
+        Ptr<ArrivalPhy> rx = m_uplink ? b.gnbPhy : b.uePhy;
+        b.channel->AddRx(rx);
+        Ptr<SpectrumSignalParameters> signal = MakeSignal(m_uplink, m_control, tx, b.model);
+
+        // The service hop alone; the bench's 250 us relay processing must not appear.
+        const Time firstTx = MilliSeconds(1);
+        Simulator::Schedule(firstTx, &MultiModelSpectrumChannel::StartTx, b.channel, signal);
+        Simulator::Schedule(firstTx + g_serviceDelay - NanoSeconds(1), [this, rx]() {
+            NS_TEST_ASSERT_MSG_EQ(rx->arrivals.size(),
+                                  0,
+                                  "Signal arrived before the service-hop delay");
+        });
+
+        // Moving the gateway changes the feeder link, which a transparent walk would see. The
+        // regenerative hop does not touch it.
+        const Time secondTx = MilliSeconds(50);
+        Simulator::Schedule(secondTx, [b, signal]() {
+            b.gt->SetPosition(Vector(5000000, 5000000, 0));
+            b.channel->StartTx(signal);
+        });
+
+        // The service hop itself still follows the live geometry: 800 km across, 600 km up.
+        const Time thirdTx = MilliSeconds(100);
+        Simulator::Schedule(thirdTx, [b, signal]() {
+            b.ue->SetPosition(Vector(1000000, 800000, 0));
+            b.channel->StartTx(signal);
+        });
+        const Time movedDelay = Seconds(1000000.0 / SpeedOfLightMps);
+        Simulator::Run();
+
+        NS_TEST_ASSERT_MSG_EQ(rx->arrivals.size(),
+                              3,
+                              "All three transmissions must arrive exactly once");
+        if (rx->arrivals.size() == 3)
+        {
+            NS_TEST_ASSERT_MSG_EQ_TOL(rx->arrivals[0],
+                                      firstTx + g_serviceDelay,
+                                      NanoSeconds(1),
+                                      "Regenerative arrival must be the service hop alone, with "
+                                      "no relay processing");
+            NS_TEST_ASSERT_MSG_EQ_TOL(rx->arrivals[1],
+                                      secondTx + g_serviceDelay,
+                                      NanoSeconds(1),
+                                      "Moving the gateway must not change the "
+                                      "regenerative delay");
+            NS_TEST_ASSERT_MSG_EQ_TOL(rx->arrivals[2],
+                                      thirdTx + movedDelay,
+                                      NanoSeconds(1),
+                                      "The regenerative delay must follow the live service-hop "
+                                      "geometry");
+            NS_TEST_ASSERT_MSG_EQ(rx->signals[0]->duration,
+                                  signal->duration,
+                                  "Propagation must preserve signal duration");
+        }
+
+        // The delay the timing advance and K_offset use agrees with what arrived.
+        NS_TEST_ASSERT_MSG_EQ_TOL(b.delay->GetOneWayDelay(b.sat, b.ue),
+                                  movedDelay,
+                                  NanoSeconds(1),
+                                  "Regenerative GetOneWayDelay() must be the observed delay");
+        Simulator::Destroy();
+    }
+
+    bool m_uplink;
+    bool m_control;
+};
+
+class NtnPropagationTimingSuite : public TestSuite
+{
+  public:
+    NtnPropagationTimingSuite()
+        : TestSuite("nr-ntn-propagation-timing", Type::UNIT)
+    {
+        for (bool uplink : {false, true})
+        {
+            for (bool control : {false, true})
+            {
+                AddTestCase(new NtnPropagationTimingCase(uplink, control), Duration::QUICK);
+                AddTestCase(new NtnRegenerativeTimingCase(uplink, control), Duration::QUICK);
+            }
+        }
+    }
+};
+
+static NtnPropagationTimingSuite g_ntnPropagationTimingSuite;
+
+} // namespace
+} // namespace ns3
diff --git a/test/nr-test-ntn-random-access.cc b/test/nr-test-ntn-random-access.cc
new file mode 100644
index 00000000..33e92999
--- /dev/null
+++ b/test/nr-test-ntn-random-access.cc
@@ -0,0 +1,539 @@
+// Copyright (c) 2026 Jesse Chiu (Kuan-Po), University of Washington
+//
+// SPDX-License-Identifier: GPL-2.0-only
+
+/**
+ * @ingroup test
+ * @file nr-test-ntn-random-access.cc
+ *
+ * @brief Test suite (nr-ntn-random-access): random access under physical propagation delay.
+ *
+ * The UE arms its RA response timeout SlotPeriod * (6 + RaResponseWindowSize) after the
+ * preamble (9 ms by default at numerology 0), while the RAR comes back one round-trip time
+ * plus the gNB's own RAR latency L0 later. The suite measures L0 at zero delay, shows that a
+ * round trip beyond the window makes the timeout fire and the preamble retry when
+ * NrUeMac::IdealRandomAccess is false and NrUePhy::TimingAdvance is zero, that the timeout
+ * shifted by 2 * TimingAdvance (the UE-gNB round-trip time of TS 38.213 clause 8, Rel-17) lets
+ * the same random access complete on the first preamble, that IdealRandomAccess never times
+ * out, and that a delay that outlives NrGnbRrc::ConnectionRequestTimeoutDuration (15 ms by
+ * default, armed when the gNB creates the UE context on preamble reception, before the RAR
+ * even leaves) drops the UE context under ideal RRC unless the attribute is raised.
+ *
+ * The cell is FDD (a DL-only and an UL-only BWP) with a ConstantSpeedPropagationDelayModel
+ * whose speed is scaled so that short distances give millisecond delays. Ideal RRC.
+ */
+
+#include "ns3/boolean.h"
+#include "ns3/config.h"
+#include "ns3/constant-position-mobility-model.h"
+#include "ns3/double.h"
+#include "ns3/internet-stack-helper.h"
+#include "ns3/ipv4-interface-container.h"
+#include "ns3/isotropic-antenna-model.h"
+#include "ns3/log.h"
+#include "ns3/mobility-helper.h"
+#include "ns3/nr-channel-helper.h"
+#include "ns3/nr-control-messages.h"
+#include "ns3/nr-gnb-net-device.h"
+#include "ns3/nr-gnb-phy.h"
+#include "ns3/nr-gnb-rrc.h"
+#include "ns3/nr-helper.h"
+#include "ns3/nr-point-to-point-epc-helper.h"
+#include "ns3/nr-ue-mac.h"
+#include "ns3/nr-ue-net-device.h"
+#include "ns3/nr-ue-phy.h"
+#include "ns3/nr-ue-rrc.h"
+#include "ns3/nstime.h"
+#include "ns3/position-allocator.h"
+#include "ns3/propagation-delay-model.h"
+#include "ns3/propagation-loss-model.h"
+#include "ns3/simulator.h"
+#include "ns3/string.h"
+#include "ns3/test.h"
+#include "ns3/uinteger.h"
+
+#include <string>
+
+using namespace ns3;
+
+NS_LOG_COMPONENT_DEFINE("NrNtnRandomAccessTest");
+
+namespace
+{
+
+/// Propagation speed of the test channel: 5 m of distance give 1 ms of one-way delay, so the
+/// delays of the test are set by the UE position while the log-distance path loss stays small.
+constexpr double g_propagationSpeedMps = 5000.0;
+
+/// Default of NrGnbRrc::ConnectionRequestTimeoutDuration, restored before every case
+const Time g_defaultConnectionRequestTimeout = MilliSeconds(15);
+
+} // namespace
+
+/**
+ * @ingroup nr-test
+ *
+ * @brief One FDD cell and one UE at a given one-way delay that attaches with ideal RRC; the
+ * random access and the gNB's UE context are observed through traces.
+ */
+class NrNtnRandomAccessTestCase : public TestCase
+{
+  public:
+    /// What the case must show
+    enum Outcome
+    {
+        RA_FIRST_PREAMBLE, ///< RA completes on the first preamble, no timeout
+        RA_TIMES_OUT,      ///< the RA response timeout fires and preambles are retried
+        CONTEXT_DROPPED,   ///< the gNB drops the UE context before the connection request
+        CONTEXT_KEPT       ///< the gNB keeps the UE context and the connection is established
+    };
+
+    /**
+     * Constructor
+     * @param name the name of the test case
+     * @param delay one-way propagation delay
+     * @param idealRandomAccess NrUeMac::IdealRandomAccess
+     * @param timingAdvance set NrUePhy::TimingAdvance to the delay (true) or leave it at 0
+     * @param kOffset NrGnbPhy::CellSpecificKoffset
+     * @param connectionRequestTimeout NrGnbRrc::ConnectionRequestTimeoutDuration
+     * @param outcome what the case must show
+     */
+    NrNtnRandomAccessTestCase(const std::string& name,
+                              Time delay,
+                              bool idealRandomAccess,
+                              bool timingAdvance,
+                              uint32_t kOffset,
+                              Time connectionRequestTimeout,
+                              Outcome outcome)
+        : TestCase(name),
+          m_delay(delay),
+          m_idealRandomAccess(idealRandomAccess),
+          m_timingAdvance(timingAdvance),
+          m_kOffset(kOffset),
+          m_connectionRequestTimeout(connectionRequestTimeout),
+          m_outcome(outcome)
+    {
+    }
+
+  private:
+    void DoRun() override;
+
+    /// NrUeMac::UeMacTxedCtrlMsgsTrace: RACH preambles requested from the PHY
+    void UeMacTxed(uint64_t imsi,
+                   SfnSf sfn,
+                   uint16_t cellId,
+                   uint16_t rnti,
+                   uint8_t bwpId,
+                   Ptr<const NrControlMessage> msg);
+    /// NrUeMac::UeMacRxedCtrlMsgsTrace: RARs
+    void UeMacRxed(uint64_t imsi,
+                   SfnSf sfn,
+                   uint16_t cellId,
+                   uint16_t rnti,
+                   uint8_t bwpId,
+                   Ptr<const NrControlMessage> msg);
+    /// NrUeMac::RaResponseTimeout
+    void RaResponseTimeout(uint64_t imsi, bool contention, uint8_t count, uint8_t max);
+    /// NrUeRrc::RandomAccessSuccessful
+    void RandomAccessSuccessful(uint64_t imsi, uint16_t cellId, uint16_t rnti);
+    /// NrUeRrc::ConnectionEstablished
+    void UeConnectionEstablished(uint64_t imsi, uint16_t cellId, uint16_t rnti);
+    /// NrGnbRrc::ConnectionEstablished
+    void GnbConnectionEstablished(uint64_t imsi, uint16_t cellId, uint16_t rnti);
+    /// NrGnbRrc::NewUeContext
+    void GnbNewUeContext(uint16_t cellId, uint16_t rnti);
+    /// NrGnbRrc::RrcTimeout
+    void GnbRrcTimeout(uint64_t imsi, uint16_t cellId, uint16_t rnti, std::string cause);
+    /// Scheduled right after a connection request timeout: record whether the context is gone
+    void CheckContextAfterTimeout(uint16_t rnti);
+
+    Time m_delay;                    ///< One-way delay
+    bool m_idealRandomAccess;        ///< NrUeMac::IdealRandomAccess
+    bool m_timingAdvance;            ///< Configure the timing advance
+    uint32_t m_kOffset;              ///< Cell-specific K_offset
+    Time m_connectionRequestTimeout; ///< NrGnbRrc::ConnectionRequestTimeoutDuration
+    Outcome m_outcome;               ///< Expected outcome
+
+    Ptr<NrGnbRrc> m_gnbRrc;                  ///< The gNB RRC, for context checks
+    uint32_t m_preambles{0};                 ///< RACH preambles requested by the UE MAC
+    uint32_t m_rars{0};                      ///< RARs received by the UE MAC
+    uint32_t m_raTimeouts{0};                ///< RA response timeouts
+    uint32_t m_raSuccesses{0};               ///< Random access successes at the UE RRC
+    uint32_t m_ueConnections{0};             ///< Connections established at the UE RRC
+    uint32_t m_gnbConnections{0};            ///< Connections established at the gNB RRC
+    uint32_t m_gnbContexts{0};               ///< UE contexts created at the gNB RRC
+    uint32_t m_connectionRequestTimeouts{0}; ///< Connection request timeouts at the gNB RRC
+    bool m_contextAfterTimeout{true};        ///< The UE context still exists after the timeout
+    Time m_firstPreamble{Time::Min()};       ///< When the first preamble was requested
+    Time m_firstRar{Time::Min()};            ///< When the first RAR was received
+};
+
+void
+NrNtnRandomAccessTestCase::UeMacTxed([[maybe_unused]] uint64_t imsi,
+                                     [[maybe_unused]] SfnSf sfn,
+                                     [[maybe_unused]] uint16_t cellId,
+                                     [[maybe_unused]] uint16_t rnti,
+                                     [[maybe_unused]] uint8_t bwpId,
+                                     Ptr<const NrControlMessage> msg)
+{
+    if (msg->GetMessageType() != NrControlMessage::RACH_PREAMBLE)
+    {
+        return;
+    }
+    if (m_preambles == 0)
+    {
+        m_firstPreamble = Simulator::Now();
+    }
+    m_preambles++;
+    NS_LOG_INFO("Preamble " << m_preambles << " at " << Simulator::Now().As(Time::MS));
+}
+
+void
+NrNtnRandomAccessTestCase::UeMacRxed([[maybe_unused]] uint64_t imsi,
+                                     [[maybe_unused]] SfnSf sfn,
+                                     [[maybe_unused]] uint16_t cellId,
+                                     [[maybe_unused]] uint16_t rnti,
+                                     [[maybe_unused]] uint8_t bwpId,
+                                     Ptr<const NrControlMessage> msg)
+{
+    if (msg->GetMessageType() != NrControlMessage::RAR)
+    {
+        return;
+    }
+    if (m_rars == 0)
+    {
+        m_firstRar = Simulator::Now();
+    }
+    m_rars++;
+    NS_LOG_INFO("RAR " << m_rars << " at " << Simulator::Now().As(Time::MS));
+}
+
+void
+NrNtnRandomAccessTestCase::RaResponseTimeout([[maybe_unused]] uint64_t imsi,
+                                             [[maybe_unused]] bool contention,
+                                             uint8_t count,
+                                             uint8_t max)
+{
+    m_raTimeouts++;
+    NS_LOG_INFO("RA response timeout " << m_raTimeouts << " at " << Simulator::Now().As(Time::MS)
+                                       << " (preamble transmission " << +count << " of " << +max
+                                       << ")");
+}
+
+void
+NrNtnRandomAccessTestCase::RandomAccessSuccessful([[maybe_unused]] uint64_t imsi,
+                                                  [[maybe_unused]] uint16_t cellId,
+                                                  [[maybe_unused]] uint16_t rnti)
+{
+    m_raSuccesses++;
+}
+
+void
+NrNtnRandomAccessTestCase::UeConnectionEstablished([[maybe_unused]] uint64_t imsi,
+                                                   [[maybe_unused]] uint16_t cellId,
+                                                   [[maybe_unused]] uint16_t rnti)
+{
+    m_ueConnections++;
+}
+
+void
+NrNtnRandomAccessTestCase::GnbConnectionEstablished([[maybe_unused]] uint64_t imsi,
+                                                    [[maybe_unused]] uint16_t cellId,
+                                                    [[maybe_unused]] uint16_t rnti)
+{
+    m_gnbConnections++;
+}
+
+void
+NrNtnRandomAccessTestCase::GnbNewUeContext([[maybe_unused]] uint16_t cellId,
+                                           [[maybe_unused]] uint16_t rnti)
+{
+    m_gnbContexts++;
+}
+
+void
+NrNtnRandomAccessTestCase::GnbRrcTimeout([[maybe_unused]] uint64_t imsi,
+                                         [[maybe_unused]] uint16_t cellId,
+                                         uint16_t rnti,
+                                         std::string cause)
+{
+    if (cause != "ConnectionRequestTimeout")
+    {
+        return;
+    }
+    m_connectionRequestTimeouts++;
+    NS_LOG_INFO("Connection request timeout for RNTI " << rnti << " at "
+                                                       << Simulator::Now().As(Time::MS));
+    if (m_outcome == CONTEXT_DROPPED)
+    {
+        // The context is removed right after this trace. The RAR is already on its way to the
+        // UE, whose ideal RRC connection request would then reach a gNB that has no UE manager
+        // for the RNTI (NrGnbRrc::DoRecvRrcConnectionRequest does not check for it), so the
+        // case ends here, once the removal is observable.
+        Simulator::ScheduleNow(&NrNtnRandomAccessTestCase::CheckContextAfterTimeout, this, rnti);
+    }
+}
+
+void
+NrNtnRandomAccessTestCase::CheckContextAfterTimeout(uint16_t rnti)
+{
+    m_contextAfterTimeout = m_gnbRrc->HasUeManager(rnti);
+    Simulator::Stop();
+}
+
+void
+NrNtnRandomAccessTestCase::DoRun()
+{
+    Config::SetDefault("ns3::NrGnbRrc::ConnectionRequestTimeoutDuration",
+                       TimeValue(m_connectionRequestTimeout));
+
+    auto nrEpcHelper = CreateObject<NrPointToPointEpcHelper>();
+    auto nrHelper = CreateObject<NrHelper>();
+    nrHelper->SetEpcHelper(nrEpcHelper);
+    nrHelper->SetGnbPhyAttribute("CellSpecificKoffset", UintegerValue(m_kOffset));
+    nrHelper->SetGnbPhyAttribute("Numerology", UintegerValue(0));
+    nrHelper->SetUeMacAttribute("IdealRandomAccess", BooleanValue(m_idealRandomAccess));
+    if (m_timingAdvance)
+    {
+        nrHelper->SetUePhyAttribute("TimingAdvance", TimeValue(m_delay));
+    }
+
+    nrHelper->SetUeAntennaTypeId(IsotropicAntennaModel::GetTypeId().GetName());
+    nrHelper->SetGnbAntennaTypeId(IsotropicAntennaModel::GetTypeId().GetName());
+
+    Config::SetDefault("ns3::LogDistancePropagationLossModel::Exponent", DoubleValue(3.5));
+    Config::SetDefault("ns3::LogDistancePropagationLossModel::ReferenceLoss", DoubleValue(35));
+
+    Ptr<NrChannelHelper> channelHelper = CreateObject<NrChannelHelper>();
+    channelHelper->ConfigurePropagationFactory(LogDistancePropagationLossModel::GetTypeId());
+
+    // FDD: a DL-only and an UL-only carrier, one BWP each
+    CcBwpCreator ccBwpCreator;
+    CcBwpCreator::SimpleOperationBandConf dlBandConf(2.8e9, 20e6, static_cast<uint8_t>(1));
+    CcBwpCreator::SimpleOperationBandConf ulBandConf(2.9e9, 20e6, static_cast<uint8_t>(1));
+    OperationBandInfo dlBand = ccBwpCreator.CreateOperationBandContiguousCc(dlBandConf);
+    OperationBandInfo ulBand = ccBwpCreator.CreateOperationBandContiguousCc(ulBandConf);
+    channelHelper->AssignChannelsToBands({dlBand, ulBand});
+    BandwidthPartInfoPtrVector allBwps = CcBwpCreator::GetAllBwps({dlBand, ulBand});
+
+    for (const auto& bwp : allBwps)
+    {
+        auto delayModel = CreateObject<ConstantSpeedPropagationDelayModel>();
+        delayModel->SetSpeed(g_propagationSpeedMps);
+        bwp.get()->GetChannel()->SetPropagationDelayModel(delayModel);
+    }
+
+    nrHelper->SetGnbBwpManagerAlgorithmAttribute("NGBR_VIDEO_TCP_DEFAULT", UintegerValue(0));
+
+    NodeContainer gnbNodes;
+    gnbNodes.Create(1);
+    NodeContainer ueNodes;
+    ueNodes.Create(1);
+
+    auto posAlloc = CreateObject<ListPositionAllocator>();
+    posAlloc->Add(Vector(0, 0, 0));
+    posAlloc->Add(Vector(m_delay.GetSeconds() * g_propagationSpeedMps, 0, 0));
+    MobilityHelper mobilityHelper;
+    mobilityHelper.SetMobilityModel("ns3::ConstantPositionMobilityModel");
+    mobilityHelper.SetPositionAllocator(posAlloc);
+    mobilityHelper.Install(gnbNodes);
+    mobilityHelper.Install(ueNodes);
+
+    NetDeviceContainer gnbDevs = nrHelper->InstallGnbDevice(gnbNodes, allBwps);
+    NetDeviceContainer ueDevs = nrHelper->InstallUeDevice(ueNodes, allBwps);
+
+    NrHelper::GetGnbPhy(gnbDevs.Get(0), 0)
+        ->SetAttribute("Pattern", StringValue("DL|DL|DL|DL|DL|DL|DL|DL|DL|DL|"));
+    NrHelper::GetGnbPhy(gnbDevs.Get(0), 1)
+        ->SetAttribute("Pattern", StringValue("UL|UL|UL|UL|UL|UL|UL|UL|UL|UL|"));
+
+    for (uint32_t bwp = 0; bwp < 2; ++bwp)
+    {
+        auto ueMac = NrHelper::GetUeMac(ueDevs.Get(0), bwp);
+        ueMac->TraceConnectWithoutContext(
+            "UeMacTxedCtrlMsgsTrace",
+            MakeCallback(&NrNtnRandomAccessTestCase::UeMacTxed, this));
+        ueMac->TraceConnectWithoutContext(
+            "UeMacRxedCtrlMsgsTrace",
+            MakeCallback(&NrNtnRandomAccessTestCase::UeMacRxed, this));
+        ueMac->TraceConnectWithoutContext(
+            "RaResponseTimeout",
+            MakeCallback(&NrNtnRandomAccessTestCase::RaResponseTimeout, this));
+    }
+    auto ueRrc = DynamicCast<NrUeNetDevice>(ueDevs.Get(0))->GetRrc();
+    ueRrc->TraceConnectWithoutContext(
+        "RandomAccessSuccessful",
+        MakeCallback(&NrNtnRandomAccessTestCase::RandomAccessSuccessful, this));
+    ueRrc->TraceConnectWithoutContext(
+        "ConnectionEstablished",
+        MakeCallback(&NrNtnRandomAccessTestCase::UeConnectionEstablished, this));
+    m_gnbRrc = DynamicCast<NrGnbNetDevice>(gnbDevs.Get(0))->GetRrc();
+    m_gnbRrc->TraceConnectWithoutContext(
+        "ConnectionEstablished",
+        MakeCallback(&NrNtnRandomAccessTestCase::GnbConnectionEstablished, this));
+    m_gnbRrc->TraceConnectWithoutContext(
+        "NewUeContext",
+        MakeCallback(&NrNtnRandomAccessTestCase::GnbNewUeContext, this));
+    m_gnbRrc->TraceConnectWithoutContext(
+        "RrcTimeout",
+        MakeCallback(&NrNtnRandomAccessTestCase::GnbRrcTimeout, this));
+
+    InternetStackHelper inetStackHelper;
+    inetStackHelper.Install(ueNodes);
+    Ipv4InterfaceContainer ueIfs = nrEpcHelper->AssignUeIpv4Address(ueDevs);
+    nrEpcHelper->SetupRemoteHost("100Gb/s", 2500, Seconds(0.000));
+
+    nrHelper->AttachToGnb(ueDevs.Get(0), gnbDevs.Get(0));
+
+    Simulator::Stop(MilliSeconds(300));
+    Simulator::Run();
+
+    const Time rarLatency = (m_firstRar > m_firstPreamble) ? m_firstRar - m_firstPreamble : Time(0);
+    NS_LOG_INFO(GetName() << ": preambles " << m_preambles << ", RARs " << m_rars
+                          << ", RA timeouts " << m_raTimeouts << ", RA successes " << m_raSuccesses
+                          << ", UE connections " << m_ueConnections << ", gNB contexts "
+                          << m_gnbContexts << ", gNB connections " << m_gnbConnections
+                          << ", connection request timeouts " << m_connectionRequestTimeouts
+                          << ", first RAR " << rarLatency.As(Time::MS) << " after the preamble");
+    if (m_delay.IsZero() && m_rars > 0)
+    {
+        NS_LOG_UNCOND("nr-ntn-random-access: zero-delay RAR latency L0 = "
+                      << rarLatency.As(Time::US) << " (preamble to RAR, "
+                      << (m_idealRandomAccess ? "ideal" : "realistic") << " random access)");
+    }
+
+    NS_TEST_ASSERT_MSG_GT(m_preambles, 0, "The UE sent no RACH preamble");
+    NS_TEST_ASSERT_MSG_GT(m_gnbContexts, 0, "The gNB created no UE context");
+
+    switch (m_outcome)
+    {
+    case RA_FIRST_PREAMBLE:
+        NS_TEST_ASSERT_MSG_EQ(m_raTimeouts, 0, "The RA response timeout fired");
+        NS_TEST_ASSERT_MSG_EQ(m_preambles, 1, "The preamble was retransmitted");
+        NS_TEST_ASSERT_MSG_EQ(m_raSuccesses, 1, "Random access did not complete once");
+        NS_TEST_ASSERT_MSG_EQ(m_ueConnections, 1, "The UE did not connect");
+        NS_TEST_ASSERT_MSG_EQ(m_gnbConnections, 1, "The gNB did not report the connection");
+        break;
+    case RA_TIMES_OUT:
+        NS_TEST_ASSERT_MSG_GT(m_raTimeouts, 0, "The RA response timeout did not fire");
+        NS_TEST_ASSERT_MSG_GT(m_preambles, 1, "The preamble was not retransmitted");
+        NS_TEST_ASSERT_MSG_EQ(m_raSuccesses,
+                              0,
+                              "Random access completed although the RAR cannot fit the window");
+        NS_TEST_ASSERT_MSG_EQ(m_ueConnections, 0, "The UE connected");
+        break;
+    case CONTEXT_DROPPED:
+        NS_TEST_ASSERT_MSG_GT(m_connectionRequestTimeouts,
+                              0,
+                              "NrGnbRrc::ConnectionRequestTimeoutDuration did not expire");
+        NS_TEST_ASSERT_MSG_EQ(m_contextAfterTimeout,
+                              false,
+                              "The gNB kept the UE context after the timeout");
+        NS_TEST_ASSERT_MSG_EQ(m_gnbConnections, 0, "The gNB established the connection");
+        NS_TEST_ASSERT_MSG_EQ(m_ueConnections, 0, "The UE established the connection");
+        break;
+    case CONTEXT_KEPT:
+        NS_TEST_ASSERT_MSG_EQ(m_connectionRequestTimeouts,
+                              0,
+                              "NrGnbRrc::ConnectionRequestTimeoutDuration expired");
+        NS_TEST_ASSERT_MSG_EQ(m_raTimeouts, 0, "The RA response timeout fired");
+        NS_TEST_ASSERT_MSG_EQ(m_raSuccesses, 1, "Random access did not complete once");
+        NS_TEST_ASSERT_MSG_EQ(m_gnbConnections, 1, "The gNB did not establish the connection");
+        NS_TEST_ASSERT_MSG_EQ(m_ueConnections, 1, "The UE did not establish the connection");
+        NS_TEST_ASSERT_MSG_EQ(m_gnbRrc->GetUeMap().size(),
+                              1,
+                              "The gNB does not hold one UE context");
+        break;
+    }
+
+    Simulator::Destroy();
+    Config::SetDefault("ns3::NrGnbRrc::ConnectionRequestTimeoutDuration",
+                       TimeValue(g_defaultConnectionRequestTimeout));
+}
+
+/**
+ * @ingroup nr-test
+ * @brief Test suite nr-ntn-random-access
+ */
+class NrNtnRandomAccessTestSuite : public TestSuite
+{
+  public:
+    NrNtnRandomAccessTestSuite()
+        : TestSuite("nr-ntn-random-access", Type::SYSTEM)
+    {
+        using TC = NrNtnRandomAccessTestCase;
+        const Time defaultTimeout = g_defaultConnectionRequestTimeout;
+
+        // (a) zero delay: RA completes within the default window; L0 is logged
+        AddTestCase(new TC("Zero delay, ideal random access",
+                           Seconds(0),
+                           true,
+                           false,
+                           0,
+                           defaultTimeout,
+                           TC::RA_FIRST_PREAMBLE),
+                    TestCase::Duration::QUICK);
+        AddTestCase(new TC("Zero delay, realistic random access",
+                           Seconds(0),
+                           false,
+                           false,
+                           0,
+                           defaultTimeout,
+                           TC::RA_FIRST_PREAMBLE),
+                    TestCase::Duration::QUICK);
+
+        // (b)-(d) a 5 ms one-way delay: the 10 ms round trip plus L0 exceeds the 9 ms window.
+        // K_offset covers the round trip (10 slots) for the Msg3 grant.
+        const Time delay = MilliSeconds(5);
+        const uint32_t kOffset = 12;
+        AddTestCase(new TC("5 ms delay, realistic random access, no timing advance: times out",
+                           delay,
+                           false,
+                           false,
+                           kOffset,
+                           defaultTimeout,
+                           TC::RA_TIMES_OUT),
+                    TestCase::Duration::QUICK);
+        AddTestCase(new TC("5 ms delay, realistic random access, timing advance: first preamble",
+                           delay,
+                           false,
+                           true,
+                           kOffset,
+                           defaultTimeout,
+                           TC::RA_FIRST_PREAMBLE),
+                    TestCase::Duration::QUICK);
+        AddTestCase(new TC("5 ms delay, ideal random access, no timing advance: first preamble",
+                           delay,
+                           true,
+                           false,
+                           kOffset,
+                           defaultTimeout,
+                           TC::RA_FIRST_PREAMBLE),
+                    TestCase::Duration::QUICK);
+
+        // (e) a 16 ms one-way delay outlives the default 15 ms ConnectionRequestTimeoutDuration,
+        // which the gNB arms on preamble reception: the RAR is still in flight when the context
+        // is dropped. RTT + 20 ms keeps it. K_offset covers the 32-slot round trip.
+        const Time longDelay = MilliSeconds(16);
+        const uint32_t longKoffset = 34;
+        AddTestCase(new TC("16 ms delay, default ConnectionRequestTimeoutDuration: context dropped",
+                           longDelay,
+                           true,
+                           true,
+                           longKoffset,
+                           defaultTimeout,
+                           TC::CONTEXT_DROPPED),
+                    TestCase::Duration::QUICK);
+        AddTestCase(new TC("16 ms delay, ConnectionRequestTimeoutDuration = RTT + 20 ms: kept",
+                           longDelay,
+                           true,
+                           true,
+                           longKoffset,
+                           2 * longDelay + MilliSeconds(20),
+                           TC::CONTEXT_KEPT),
+                    TestCase::Duration::QUICK);
+    }
+};
+
+/// Static variable for test initialization
+static NrNtnRandomAccessTestSuite g_nrNtnRandomAccessTestSuite;
