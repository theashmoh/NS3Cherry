+}
+
+double
+DbToLinear(double valueDb)
+{
+    return std::pow(10.0, valueDb / 10.0);
+}
+
+double
+LinearToDb(double valueLinear)
+{
+    return 10.0 * std::log10(std::max(valueLinear, std::numeric_limits<double>::min()));
