+/**
+ * @brief Checks the downlink outer-loop link adaptation law
+ *
+ * OLLA moves an MCS offset up on every ACKed first transmission and down on every NACKed one,
+ * with the two step sizes in the ratio that makes the offset stationary at the configured
+ * target BLER. The offset is clamped, and the whole loop is off unless OllaStepUp is set.
+ */
+class NrTestMacSchedulerDlOlla : public TestCase
+{
+  public:
+    NrTestMacSchedulerDlOlla()
+        : TestCase("DL OLLA steps towards the target BLER and stays clamped")
+    {
+    }
+
+  private:
+    void DoRun() override;
+
+    /**
+     * @brief Build a scheduler with one UE attached
+     * @param stepUp value of the OllaStepUp attribute
+     * @param targetBler value of the OllaTargetBler attribute
+     * @param maxOffset value of the OllaMaxOffset attribute
+     * @return the scheduler
+     */
+    Ptr<NrMacSchedulerNs3> MakeSched(double stepUp, double targetBler, double maxOffset);
+
+    static constexpr uint16_t RNTI = 0; //!< RNTI of the single UE
+
+    TestSchedSapUserHarq m_schedSapUser;   //!< SAP user kept alive for the scheduler
+    TestCschedSapUserHarq m_cschedSapUser; //!< SAP user kept alive for the scheduler
+};
+
+Ptr<NrMacSchedulerNs3>
+NrTestMacSchedulerDlOlla::MakeSched(double stepUp, double targetBler, double maxOffset)
+{
+    Ptr<NrMacSchedulerNs3> sched = CreateObject<NrMacSchedulerTdmaRR>();
+    sched->SetAttribute("OllaStepUp", DoubleValue(stepUp));
+    sched->SetAttribute("OllaTargetBler", DoubleValue(targetBler));
+    sched->SetAttribute("OllaMaxOffset", DoubleValue(maxOffset));
+    sched->InstallDlAmc(CreateObject<NrAmc>());
+    sched->InstallUlAmc(CreateObject<NrAmc>());
+    sched->SetMacSchedSapUser(&m_schedSapUser);
+    sched->SetMacCschedSapUser(&m_cschedSapUser);
+
+    auto cellConfig = NrMacCschedSapProvider::CschedCellConfigReqParameters();
+    cellConfig.m_dlBandwidth = 10;
+    cellConfig.m_ulBandwidth = 10;
+    sched->DoCschedCellConfigReq(cellConfig);
+
+    NrMacCschedSapProvider::CschedUeConfigReqParameters ueConf{};
+    ueConf.m_rnti = RNTI;
+    ueConf.m_transmissionMode = 0;
+    ueConf.m_beamId = BeamId(0, 0);
+    sched->DoCschedUeConfigReq(ueConf);
+    return sched;
+}
+
+void
+NrTestMacSchedulerDlOlla::DoRun()
+{
+    const double tolerance = 1e-9;
+
+    // Off by default: no attribute set, so nothing moves and GetDlMcs() is the CSI value
+    {
+        auto sched = MakeSched(0.0, 0.1, 4.0);
+        const auto& ue = sched->m_ueMap.find(RNTI)->second;
+        const uint8_t csiMcs = ue->GetDlMcs();
+        sched->UpdateDlOlla(RNTI, false);
+        sched->UpdateDlOlla(RNTI, true);
+        NS_TEST_ASSERT_MSG_EQ_TOL(ue->m_dlOlla,
+                                  0.0,
+                                  tolerance,
+                                  "OLLA must not move while OllaStepUp is 0");
+        NS_TEST_ASSERT_MSG_EQ(ue->GetDlMcs(),
+                              csiMcs,
+                              "With OLLA disabled GetDlMcs() must return the CSI value");
+    }
+
+    // One ACK steps up by OllaStepUp; one NACK steps down by stepUp*(1-target)/target
+    {
+        auto sched = MakeSched(0.1, 0.1, 4.0);
+        const auto& ue = sched->m_ueMap.find(RNTI)->second;
+        sched->UpdateDlOlla(RNTI, true);
+        NS_TEST_ASSERT_MSG_EQ_TOL(ue->m_dlOlla,
+                                  0.1,
+                                  tolerance,
+                                  "An ACK must step up by OllaStepUp");
+        sched->UpdateDlOlla(RNTI, false);
+        NS_TEST_ASSERT_MSG_EQ_TOL(ue->m_dlOlla,
+                                  -0.8,
+                                  tolerance,
+                                  "A NACK must step down by OllaStepUp*(1-target)/target");
+    }
+
+    // At the target BLER the offset is stationary: one NACK per nine ACKs returns it to zero
+    {
+        auto sched = MakeSched(0.1, 0.1, 4.0);
+        const auto& ue = sched->m_ueMap.find(RNTI)->second;
+        for (uint32_t round = 0; round < 5; ++round)
+        {
+            for (uint32_t ack = 0; ack < 9; ++ack)
+            {
+                sched->UpdateDlOlla(RNTI, true);
+            }
+            sched->UpdateDlOlla(RNTI, false);
+        }
+        NS_TEST_ASSERT_MSG_EQ_TOL(ue->m_dlOlla,
+                                  0.0,
+                                  tolerance,
+                                  "At the target BLER the offset must not drift");
+    }
+
+    // The offset is clamped in both directions, and the clamp raises or lowers the MCS
+    {
+        auto sched = MakeSched(0.5, 0.1, 2.0);
+        const auto& ue = sched->m_ueMap.find(RNTI)->second;
+        const uint8_t csiMcs = ue->GetDlMcsFromCsi();
+        for (uint32_t i = 0; i < 100; ++i)
+        {
+            sched->UpdateDlOlla(RNTI, true);
+        }
+        NS_TEST_ASSERT_MSG_EQ_TOL(ue->m_dlOlla, 2.0, tolerance, "OLLA must clamp above");
+        NS_TEST_ASSERT_MSG_EQ(ue->GetDlMcs(),
+                              csiMcs + 2,
+                              "The clamped offset must reach GetDlMcs()");
+        for (uint32_t i = 0; i < 100; ++i)
+        {
+            sched->UpdateDlOlla(RNTI, false);
+        }
+        NS_TEST_ASSERT_MSG_EQ_TOL(ue->m_dlOlla, -2.0, tolerance, "OLLA must clamp below");
+        NS_TEST_ASSERT_MSG_EQ(ue->GetDlMcsFromCsi(),
+                              csiMcs,
+                              "GetDlMcsFromCsi() must stay free of the OLLA offset");
+    }
+
+    Simulator::Destroy();
+}
