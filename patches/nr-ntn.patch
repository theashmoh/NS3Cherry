+/**
+ * @ingroup tests
+ *
+ * @brief Test of the AM re-segmentation of a retransmission (TS 36.322 5.2.1).
+ *
+ * A PDU is lost and NACKed, and the opportunities that follow are too small for it. The
+ * transmitter must send it as AMD PDU segments that fit, and the receiver must rebuild it from
+ * them. A second pass cuts the PDU at other offsets: segments that overlap or replace earlier
+ * ones must still complete it, as when a segment of the first pass is lost too.
+ */
+class NrRlcAmResegmentationTestCase : public NrRlcTestCaseBase
+{
+  public:
+    NrRlcAmResegmentationTestCase()
+        : NrRlcTestCaseBase("Test RLC AM: a retransmission too big for its grant is re-segmented "
+                            "and rebuilt by the receiver")
+    {
+    }
+
+  private:
+    void DoRun() override;
+
+    /**
+     * Grant opportunities until the transmitter sends nothing more and check every PDU it sends
+     * is a segment of SN 0 that fits its opportunity.
+     *
+     * @param rlc the transmitter
+     * @param capture its MAC
+     * @param bytes the opportunity size
+     * @return the segments sent
+     */
+    std::vector<Ptr<Packet>> Resend(Ptr<NrRlcAm> rlc, NrRlcTestCaptureMac& capture, uint32_t bytes);
+};
+
+std::vector<Ptr<Packet>>
+NrRlcAmResegmentationTestCase::Resend(Ptr<NrRlcAm> rlc,
+                                      NrRlcTestCaptureMac& capture,
+                                      uint32_t bytes)
+{
+    const size_t first = capture.m_pdus.size();
+    GrantTxOpportunities(rlc, bytes, 10);
+    std::vector<Ptr<Packet>> segments(capture.m_pdus.begin() + first, capture.m_pdus.end());
+    uint32_t expectedOffset = 0;
+    for (size_t i = 0; i < segments.size(); i++)
+    {
+        NS_TEST_EXPECT_MSG_LT_OR_EQ(segments[i]->GetSize(), bytes, "a segment must fit its grant");
+        Ptr<Packet> copy = segments[i]->Copy();
+        NrRlcAmHeader header;
+        copy->RemoveHeader(header);
+        NS_TEST_EXPECT_MSG_EQ(+header.GetResegmentationFlag(),
+                              +NrRlcAmHeader::SEGMENT,
+                              "a retransmission that does not fit must be a segment");
+        NS_TEST_EXPECT_MSG_EQ(header.GetSequenceNumber().GetValue(), 0, "segment of SN 0");
+        NS_TEST_EXPECT_MSG_EQ(header.GetSegmentOffset(), expectedOffset, "segments are contiguous");
+        NS_TEST_EXPECT_MSG_EQ(+header.GetLastSegmentFlag(),
+                              +(i + 1 == segments.size() ? NrRlcAmHeader::LAST_PDU_SEGMENT
+                                                         : NrRlcAmHeader::NO_LAST_PDU_SEGMENT),
+                              "only the closing segment carries LSF");
+        expectedOffset += copy->GetSize();
+    }
+    return segments;
+}
+
+void
+NrRlcAmResegmentationTestCase::DoRun()
+{
+    // Two SDUs in one PDU, so the segments also carry a length indicator.
+    const std::vector<NrRlcSduSpec> sdus = {{'A', 300}, {'B', 300}};
+    Ptr<NrRlcAm> txRlc = CreateObject<NrRlcAm>();
+    NrRlcTestCaptureMac txCapture;
+    txRlc->SetNrMacSapProvider(&txCapture);
+    QueueSdus(txRlc, sdus);
+    GrantTxOpportunities(txRlc, 700, 1);
+    NS_TEST_ASSERT_MSG_EQ(txCapture.m_pdus.size(), 1, "precondition: one PDU carries both SDUs");
+    const uint32_t pduSize = txCapture.m_pdus.at(0)->GetSize();
+
+    // The PDU is lost; each pass NACKs it and grants opportunities it does not fit.
+    DeliverStatusPdu(txRlc, 1, {0});
+    std::vector<Ptr<Packet>> pass1 = Resend(txRlc, txCapture, 200);
+    NS_TEST_ASSERT_MSG_GT(pass1.size(), 2, "precondition: pass 1 needs three segments or more");
+    DeliverStatusPdu(txRlc, 1, {0});
+    std::vector<Ptr<Packet>> pass2 = Resend(txRlc, txCapture, 300);
+    NS_TEST_ASSERT_MSG_GT(pass2.size(), 1, "precondition: pass 2 needs two segments or more");
+    NS_TEST_ASSERT_MSG_LT(pass2.size(), pass1.size(), "precondition: pass 2 cuts elsewhere");
+
+    // Lossless: the segments of one pass rebuild the PDU.
+    {
+        Ptr<NrRlcAm> rxRlc = CreateObject<NrRlcAm>();
+        NrRlcTestCaptureMac rxCapture;
+        rxRlc->SetNrMacSapProvider(&rxCapture);
+        NrRlcTestSduSink sink;
+        rxRlc->SetNrRlcSapUser(sink.GetSapUser());
+        for (const auto& segment : pass1)
+        {
+            DeliverPduToRlc(rxRlc, segment);
+        }
+        VerifyDelivered(sink, sdus, "one pass of segments");
+    }
+
+    // Segment 1 of pass 1 is lost as well. Pass 2 fills the hole with segments that start at
+    // offsets already held or overlap the ones received: the PDU must complete, once.
+    {
+        Ptr<NrRlcAm> rxRlc = CreateObject<NrRlcAm>();
+        NrRlcTestCaptureMac rxCapture;
+        rxRlc->SetNrMacSapProvider(&rxCapture);
+        NrRlcTestSduSink sink;
+        rxRlc->SetNrRlcSapUser(sink.GetSapUser());
+        for (size_t i = 0; i < pass1.size(); i++)
+        {
+            if (i != 1)
+            {
+                DeliverPduToRlc(rxRlc, pass1[i]);
+            }
+        }
+        NS_TEST_ASSERT_MSG_EQ(sink.m_sdus.size(), 0, "nothing is delivered with a hole open");
+        for (const auto& segment : pass2)
+        {
+            DeliverPduToRlc(rxRlc, segment);
+        }
+        VerifyDelivered(sink, sdus, "two passes cut at different offsets");
+    }
+
+    // A grant big enough for the whole PDU sends it unsegmented again.
+    DeliverStatusPdu(txRlc, 1, {0});
+    const size_t before = txCapture.m_pdus.size();
+    GrantTxOpportunities(txRlc, pduSize, 1);
+    NS_TEST_ASSERT_MSG_EQ(txCapture.m_pdus.size(), before + 1, "one PDU sent");
+    NS_TEST_ASSERT_MSG_EQ(txCapture.m_pdus.back()->GetSize(), pduSize, "the whole PDU is sent");
+
+    Simulator::Destroy();
+}
