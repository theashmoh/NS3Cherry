+    const auto maxMcs = static_cast<int>(m_dlAmc->GetMaxMcs());
+    const auto corrected = static_cast<int>(std::lround(csiMcs + m_dlOlla));
+    return static_cast<uint8_t>(std::clamp(corrected, 0, maxMcs));
+}
